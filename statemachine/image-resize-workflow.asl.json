{
  "Comment": "Image resizing workflow",
  "StartAt": "ResizeImage",
  "States": {
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "image-resizer",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ResizeFailed"
        }
      ],
      "Next": "CheckResizeResult"
    },
    "CheckResizeResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "SUCCESS",
          "Next": "ResizeSucceeded"
        }
      ],
      "Default": "ResizeFailed"
    },
    "ResizeSucceeded": {
      "Type": "Succeed"
    },
    "ResizeFailed": {
      "Type": "Fail",
      "Error": "ResizeFailed",
      "Cause": "The image could not be resized."
    }
  }
}
